{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "erp-financeiro",
  "compatibility_date": "2026-08-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/painel", "/painel/*"]
  }
}
